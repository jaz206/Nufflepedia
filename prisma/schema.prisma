// Modelo de datos: usuarios, equipos/ligas/partidos, y contenido maestro de
// reglas editable desde el panel de admin.
//
// El contenido maestro (habilidades, rasgos, tablas) tiene dos copias
// deliberadas:
//   - src/rules-engine/data/*.ts: la semilla original, versionada con el
//     código, testeada con Vitest. Es el punto de partida y el fallback.
//   - Las tablas Master* de aquí abajo: la copia EDITABLE en producción.
//     El admin la afina desde /admin sin tener que tocar código ni
//     desplegar. prisma/seed.ts puebla estas tablas a partir de la semilla.
// Ver docs/DATA_MODEL.md para el razonamiento completo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  USER
  ADMIN
}

model User {
  id          String   @id @default(uuid())
  /// UID de Supabase Auth. Fuente de verdad de la identidad del usuario.
  authId      String   @unique
  email       String   @unique
  displayName String
  /// Foto de perfil (viene de Google cuando el login es OAuth). Null en login por email.
  avatarUrl   String?
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())

  managedTeams       ManagedTeam[]
  commissionedComps  Competition[]      @relation("Commissioner")
  competitionEntries CompetitionEntry[]
  sentInvitations    Invitation[]       @relation("InvitedBy")
  editedMatchReports MatchReport[]      @relation("MatchReportEditor")
  liveMatches        LiveMatch[]
}

/// Estado de un jugador entre partidos (roster). Los estados transitorios de
/// un partido en curso (Tumbado, Aturdido, Inconsciente) los gestionará el
/// futuro Match Assistant en tiempo real, no esta tabla.
enum RosterPlayerStatus {
  ACTIVE
  MISS_NEXT_GAME
  NIGGLING_INJURY
  DEAD
  RETIRED
}

enum SkillSource {
  ROSTER
  LEVEL_UP
  INDUCEMENT
  STAR_PLAYER
}

model ManagedTeam {
  id               String   @id @default(uuid())
  ownerId          String
  owner            User     @relation(fields: [ownerId], references: [id])
  name             String
  /// Clave del roster oficial (catálogo estático en rules-engine), p.ej. "orcos".
  rosterKey        String
  treasury         Int      @default(0)
  rerolls          Int      @default(0)
  cheerleaders     Int      @default(0)
  assistantCoaches Int      @default(0)
  hasApothecary    Boolean  @default(false)
  fanFactor        Int      @default(1)
  /// Equipo creado al vuelo para un amistoso, por alguien sin cuenta (un
  /// amigo "invitado"). Es un ManagedTeam normal en todo lo demás — solo se
  /// oculta de "Mis equipos" para no mezclarse con los equipos reales.
  isGuest          Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  players            ManagedPlayer[]
  competitionEntries CompetitionEntry[]

  @@index([ownerId])
}

model ManagedPlayer {
  id          String             @id @default(uuid())
  teamId      String
  team        ManagedTeam        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  number      Int
  customName  String
  /// Clave de la posición dentro del roster oficial (catálogo estático).
  /// Null si el jugador es un Jugador Estrella fichado (ver starKey).
  positionKey String?
  /// Clave de MasterStarPlayer si este jugador es una Estrella fichada del
  /// mercado; null para jugadores normales del roster (ver positionKey).
  /// Exactamente uno de los dos debe estar relleno.
  starKey     String?
  spp         Int                @default(0)
  status      RosterPlayerStatus @default(ACTIVE)
  /// Mejoras de atributo compradas con PE (subida de nivel). El signo del
  /// efecto depende de la característica: MA/FU/AR suman, AG/PA restan al
  /// número "para superar" (ver MasterPosition.ag). El jugador tira el dado
  /// físicamente según la tabla del reglamento y aquí solo se registra el
  /// resultado ya decidido.
  maIncreases Int                @default(0)
  stIncreases Int                @default(0)
  agIncreases Int                @default(0)
  paIncreases Int                @default(0)
  avIncreases Int                @default(0)
  createdAt   DateTime           @default(now())

  skills PlayerSkillAssignment[]

  @@index([teamId])
}

model PlayerSkillAssignment {
  id       String        @id @default(uuid())
  playerId String
  player   ManagedPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  /// Clave de habilidad del catálogo estático (rules-engine).
  skillKey String
  source   SkillSource

  @@unique([playerId, skillKey])
}

enum CompetitionFormat {
  LEAGUE
  TOURNAMENT
}

enum CompetitionVisibility {
  PUBLIC
  PRIVATE
}

enum CompetitionStatus {
  OPEN
  IN_PROGRESS
  FINISHED
}

model Competition {
  id             String                @id @default(uuid())
  name           String
  format         CompetitionFormat
  commissionerId String
  commissioner   User                  @relation("Commissioner", fields: [commissionerId], references: [id])
  visibility     CompetitionVisibility @default(PRIVATE)
  maxTeams       Int
  status         CompetitionStatus     @default(OPEN)
  /// Configuración de reglas de la competición (muerte súbita, tiempo de turno, etc).
  rulesConfig    Json                  @default("{}")
  createdAt      DateTime              @default(now())

  /// Solo aplica si format = TOURNAMENT.
  hasGroupStage Boolean @default(false)
  groupCount    Int?
  /// [{ name: string, entryIds: string[] }] — asignación de grupos, si hasGroupStage.
  groups        Json    @default("[]")
  /// [{ round: number, matches: [{ id, homeEntryId, awayEntryId, homeScore, awayScore, winnerEntryId }] }]
  bracket       Json    @default("[]")
  /// Solo aplica si format = TOURNAMENT: "GROUPS" mientras se juega la fase de
  /// grupos, "KNOCKOUT" una vez generado el cuadro. Null en formato Liguilla.
  phase         String?

  entries      CompetitionEntry[]
  invitations  Invitation[]
  matchReports MatchReport[]
  fixtures     CompetitionFixture[]

  @@index([commissionerId])
}

model CompetitionEntry {
  id            String       @id @default(uuid())
  /// Nullable a propósito: una inscripción "amistosa" para un LiveMatch
  /// suelto no pertenece a ninguna Competition — reutiliza toda la
  /// maquinaria de plantilla-copia/box score sin necesitar una liga/torneo.
  competitionId String?
  competition   Competition? @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  /// Nullable a propósito: si el dueño disuelve el equipo real en El
  /// Cuartel, esta inscripción no debe romperse (la copia de trabajo en
  /// CompetitionPlayer ya es autosuficiente) — la referencia simplemente
  /// se queda en null. `teamName`/`rosterKey` de abajo son la copia
  /// congelada que sobrevive a esa desaparición.
  managedTeamId String?
  managedTeam   ManagedTeam? @relation(fields: [managedTeamId], references: [id], onDelete: SetNull)
  /// Nombre y raza del equipo EN EL MOMENTO de inscribirse — copia
  /// congelada, igual que la plantilla/tesorería (ver CompetitionPlayer).
  teamName      String
  rosterKey     String
  ownerId       String
  owner         User         @relation(fields: [ownerId], references: [id])
  division      String?

  /// Tesorería de esta inscripción, clonada de la plantilla base al
  /// inscribirse: los fichajes "solo para esta competición" descuentan de
  /// aquí, nunca de la tesorería real del equipo (ver CompetitionPlayer).
  snapshotTreasury Int @default(0)
  players          CompetitionPlayer[]

  played     Int @default(0)
  won        Int @default(0)
  drawn      Int @default(0)
  lost       Int @default(0)
  tdFor      Int @default(0)
  tdAgainst  Int @default(0)
  casFor     Int @default(0)
  casAgainst Int @default(0)
  points     Int @default(0)

  homeMatches MatchReport[] @relation("HomeEntry")
  awayMatches MatchReport[] @relation("AwayEntry")

  scores           MatchScorer[]
  fixturesHome     CompetitionFixture[] @relation("FixtureHome")
  fixturesAway     CompetitionFixture[] @relation("FixtureAway")
  fixturesProposed CompetitionFixture[] @relation("FixtureProposedBy")

  injuriesCaused   MatchInjury[] @relation("InjuryAttackerEntry")
  injuriesReceived MatchInjury[] @relation("InjuryVictimEntry")
  inducementPurchases MatchInducementPurchase[]

  /// Un amistoso creado por el Asistente de Partido en vivo (LiveMatch) crea
  /// exactamente una CompetitionEntry por lado — nunca ambas a la vez.
  homeLiveMatch LiveMatch? @relation("LiveMatchHome")
  awayLiveMatch LiveMatch? @relation("LiveMatchAway")

  @@unique([competitionId, managedTeamId])
  @@index([competitionId])
}

/**
 * Copia de trabajo de un jugador, aislada a UNA inscripción. Se genera
 * clonando la plantilla real (jugadores + habilidades) al inscribirse en
 * cualquier competición (liga o torneo): las PE ganadas, subidas de nivel,
 * lesiones y fichajes de esa competición viven aquí y nunca tocan la
 * plantilla base en El Cuartel (ManagedPlayer). `sourcePlayerId` es una
 * referencia informativa al ManagedPlayer original, si vino de un clonado
 * (null para jugadores fichados directamente durante la competición).
 */
model CompetitionPlayer {
  id             String             @id @default(uuid())
  entryId        String
  entry          CompetitionEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sourcePlayerId String?
  number         Int
  customName     String
  positionKey    String?
  starKey        String?
  spp            Int                @default(0)
  status         RosterPlayerStatus @default(ACTIVE)
  maIncreases    Int                @default(0)
  stIncreases    Int                @default(0)
  agIncreases    Int                @default(0)
  paIncreases    Int                @default(0)
  avIncreases    Int                @default(0)
  createdAt      DateTime           @default(now())

  skills CompetitionPlayerSkill[]
  scores MatchScorer[]

  injuriesCaused   MatchInjury[] @relation("InjuryAttackerCompPlayer")
  injuriesReceived MatchInjury[] @relation("InjuryVictimCompPlayer")

  @@index([entryId])
}

model CompetitionPlayerSkill {
  id       String            @id @default(uuid())
  playerId String
  player   CompetitionPlayer @relation(fields: [playerId], references: [id], onDelete: Cascade)
  skillKey String
  source   SkillSource

  @@unique([playerId, skillKey])
}

model MatchReport {
  id            String            @id @default(uuid())
  competitionId String?
  competition   Competition?      @relation(fields: [competitionId], references: [id])
  homeEntryId   String?
  homeEntry     CompetitionEntry? @relation("HomeEntry", fields: [homeEntryId], references: [id])
  awayEntryId   String?
  awayEntry     CompetitionEntry? @relation("AwayEntry", fields: [awayEntryId], references: [id])

  homeScore Int
  awayScore Int
  /// Log técnico de eventos de partido (ver docs/GAME_EVENTS.md una vez portado).
  gameLog   Json     @default("[]")
  headline  String?
  article   String?
  playedAt  DateTime @default(now())

  /// De dónde vino este resultado — determina si se puede editar el
  /// marcador después (BRACKET no, por ahora: el cuadro guarda su propio
  /// marcador/ganador en Competition.bracket y no está sincronizado).
  source        MatchSource @default(GROUP)
  /// Rastro de auditoría: quién corrigió el marcador por última vez, y cuándo.
  editedAt      DateTime?
  editedById    String?
  editedBy      User?       @relation("MatchReportEditor", fields: [editedById], references: [id])

  scorers    MatchScorer[]
  injuries   MatchInjury[]
  inducements MatchInducementPurchase[]
  fixture    CompetitionFixture?

  @@index([competitionId])
}

enum MatchSource {
  FIXTURE
  GROUP
  BRACKET
  /// Partido amistoso suelto, generado por el Asistente de Partido en vivo
  /// (LiveMatch), sin pertenecer a ninguna Competition.
  FRIENDLY
}

/**
 * Calendario fijo de una Liguilla: se genera al marcarla "en curso" (ida y
 * vuelta round-robin — con 2 equipos ya da 2 jornadas, local/visitante
 * invertido). Sustituye al registro libre de resultados: cada partido
 * jugado enlaza aquí con su MatchReport.
 */
model CompetitionFixture {
  id            String      @id @default(uuid())
  competitionId String
  competition   Competition @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  round         Int
  homeEntryId   String
  homeEntry     CompetitionEntry @relation("FixtureHome", fields: [homeEntryId], references: [id])
  awayEntryId   String
  awayEntry     CompetitionEntry @relation("FixtureAway", fields: [awayEntryId], references: [id])
  /// Fecha/hora propuesta para jugarlo (opcional — la pone quien quiera).
  scheduledAt      DateTime?
  /// Quién propuso la fecha actual — para pedirle confirmación al rival.
  proposedByEntryId String?
  proposedByEntry   CompetitionEntry? @relation("FixtureProposedBy", fields: [proposedByEntryId], references: [id])
  /// Se rellena cuando el otro equipo (o el comisario) confirma la fecha propuesta.
  confirmedAt       DateTime?
  matchReportId String?      @unique
  matchReport   MatchReport? @relation(fields: [matchReportId], references: [id])
  createdAt     DateTime     @default(now())

  @@index([competitionId])
}

/// Un touchdown anotado, opcionalmente atribuido a un jugador real (alimenta su SPP).
model MatchScorer {
  id            String        @id @default(uuid())
  matchReportId String
  matchReport   MatchReport   @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  entryId       String
  entry         CompetitionEntry @relation(fields: [entryId], references: [id])
  playerId      String?
  player        CompetitionPlayer? @relation(fields: [playerId], references: [id])
  createdAt     DateTime      @default(now())

  @@index([matchReportId])
}

/**
 * Una lesión del partido: quién la causó y quién la sufrió (equipo
 * siempre; jugador concreto opcional), y el resultado en la Tabla de
 * Lesiones (MasterInjuryEntry.code) si se conoce. Alimenta el SPP del
 * agresor y, si el resultado es grave, el estado del jugador lesionado.
 */
model MatchInjury {
  id               String       @id @default(uuid())
  matchReportId    String
  matchReport      MatchReport  @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  attackerEntryId  String
  attackerEntry    CompetitionEntry @relation("InjuryAttackerEntry", fields: [attackerEntryId], references: [id])
  attackerPlayerId String?
  attackerPlayer   CompetitionPlayer? @relation("InjuryAttackerCompPlayer", fields: [attackerPlayerId], references: [id])
  victimEntryId    String
  victimEntry      CompetitionEntry @relation("InjuryVictimEntry", fields: [victimEntryId], references: [id])
  victimPlayerId   String?
  victimPlayer     CompetitionPlayer? @relation("InjuryVictimCompPlayer", fields: [victimPlayerId], references: [id])
  /// Código de MasterInjuryEntry (p.ej. "MNG", "DEAD") si se sabe el resultado exacto.
  injuryCode       String?
  /// Si injuryCode.permanentStatLoss: qué característica se reduce (MA/ST/AG/PA/AV).
  /// Opcional — si no se indica, el jugador queda marcado como lesionado pero
  /// su ficha de atributos no cambia.
  statLoss         String?
  createdAt        DateTime     @default(now())

  @@index([matchReportId])
}

/**
 * Un Incentivo comprado por un equipo para un partido concreto, descontado
 * de la tesorería clonada de esa inscripción (CompetitionEntry.snapshotTreasury).
 * Solo cubre Incentivos de coste fijo (MasterInducement.cost != null) — los
 * de "precio variable" (mercenarios, Jugador Estrella, árbitro, mago, etc.)
 * necesitan su propio flujo y no se compran aquí todavía.
 */
model MatchInducementPurchase {
  id            String      @id @default(uuid())
  matchReportId String
  matchReport   MatchReport @relation(fields: [matchReportId], references: [id], onDelete: Cascade)
  entryId       String
  entry         CompetitionEntry @relation(fields: [entryId], references: [id])
  /// MasterInducement.key
  inducementKey String
  quantity      Int
  /// Coste total pagado (cost del Incentivo × quantity), congelado en el
  /// momento de la compra por si el admin cambia el precio después.
  costPaid      Int
  createdAt     DateTime    @default(now())

  @@index([matchReportId])
}

// ─────────────────────────────────────────────────────────────────────────
// Asistente de Partido en vivo (Fase 4, v1). Un LiveMatch es un amistoso
// suelto (nunca ligado a una Competition) que se juega "en directo": cada
// acción relevante queda como un LiveMatchEvent desde el primer minuto (no
// solo al terminar), para no perder nada si se cierra la pestaña a mitad de
// partido, y para que "Finalizar partido" solo tenga que RECONSTRUIR el
// resultado a partir de ese registro (reutilizando applyBoxScore) en vez de
// pedir que se rellene todo de nuevo a mano. Un solo dispositivo lleva
// ambos lados por ahora; el registro en BD desde ya deja el terreno
// preparado para que el día de mañana cada móvil se suscriba al mismo
// LiveMatch por Realtime sin rediseñar nada.
// ─────────────────────────────────────────────────────────────────────────

enum LiveMatchStatus {
  PRE_MATCH
  IN_PROGRESS
  FINISHED
}

enum LiveMatchEventType {
  FAN_FACTOR
  WEATHER_ROLL
  KICKING_TEAM_ROLL
  KICKOFF_EVENT
  TURNOVER
  TOUCHDOWN
  COMPLETED_PASS
  INTERCEPTION
  CASUALTY
  SENT_OFF
  APOTHECARY_USED
  SUBSTITUTION
  PRAYER_TO_NUFFLE
  KO_RECOVERY
  HALF_END
  NOTE
}

model LiveMatch {
  id            String          @id @default(uuid())
  status        LiveMatchStatus @default(PRE_MATCH)
  createdById   String
  createdBy     User            @relation(fields: [createdById], references: [id])

  homeEntryId String            @unique
  homeEntry   CompetitionEntry  @relation("LiveMatchHome", fields: [homeEntryId], references: [id], onDelete: Cascade)
  awayEntryId String            @unique
  awayEntry   CompetitionEntry  @relation("LiveMatchAway", fields: [awayEntryId], references: [id], onDelete: Cascade)

  half      Int @default(1)
  turn      Int @default(1)
  homeScore Int @default(0)
  awayScore Int @default(0)

  /// Resultado de la secuencia anterior al partido — se rellenan al ir
  /// resolviendo esos pasos, antes de pasar a IN_PROGRESS.
  fanFactorHome    Int?
  fanFactorAway    Int?
  weatherCode      String?
  kickingEntryId   String?

  /// Una vez finalizado, el resultado "de verdad" (marcador, crónica, PE
  /// aplicado) vive en el MatchReport igual que cualquier otro partido —
  /// este registro es solo el "cómo se jugó en directo".
  matchReportId String? @unique

  events    LiveMatchEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}

/// Registro de eventos append-only de un LiveMatch. entryId/playerId son el
/// protagonista del evento (quien anota, quien causa la baja, el equipo que
/// cambia de turno...); opponentEntryId/opponentPlayerId el otro lado
/// cuando aplica (ej. la víctima de una lesión). payload guarda datos
/// específicos de cada tipo (injuryCode/statLoss, código de clima/evento de
/// patada, texto libre de una nota).
model LiveMatchEvent {
  id              String             @id @default(uuid())
  liveMatchId     String
  liveMatch       LiveMatch          @relation(fields: [liveMatchId], references: [id], onDelete: Cascade)
  type            LiveMatchEventType
  half            Int
  turn            Int
  entryId         String?
  playerId        String?
  opponentEntryId String?
  opponentPlayerId String?
  payload         Json               @default("{}")
  createdAt       DateTime           @default(now())

  @@index([liveMatchId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model Invitation {
  id            String           @id @default(uuid())
  competitionId String
  competition   Competition      @relation(fields: [competitionId], references: [id], onDelete: Cascade)
  invitedEmail  String
  invitedById   String
  invitedBy     User             @relation("InvitedBy", fields: [invitedById], references: [id])
  status        InvitationStatus @default(PENDING)
  createdAt     DateTime         @default(now())

  @@index([competitionId])
}

// ─────────────────────────────────────────────────────────────────────────
// Contenido maestro editable (Pilar 1: habilidades, rasgos, tablas).
// ─────────────────────────────────────────────────────────────────────────

enum SkillCategory {
  GENERAL
  AGILIDAD
  FUERZA
  PASE
  MUTACION
  TRIQUINUELAS
}

model MasterSkill {
  id          String        @id @default(uuid())
  key         String        @unique
  name        String
  englishName String?
  category    SkillCategory
  isActive    Boolean       @default(false)
  isElite     Boolean       @default(false)
  description String
  /// Traduccion al ingles, curada a mano desde el admin (no viene de la
  /// semilla en rules-engine). Null/vacio hasta que alguien la rellene.
  descriptionEn String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

enum TraitCategory {
  GENERAL
  RESISTENCIA
  ATAQUE
  ACCION_ESPECIAL
  TAMANO
  DESPLIEGUE
  JUGADOR_ESTRELLA
}

model MasterTrait {
  id          String        @id @default(uuid())
  key         String        @unique
  name        String
  englishName String?
  category    TraitCategory
  description String
  /// Traduccion al ingles, curada a mano desde el admin (no viene de la
  /// semilla en rules-engine). Null/vacio hasta que alguien la rellene.
  descriptionEn String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

/// Tabla de Clima (2D6).
model MasterWeatherEntry {
  id        String   @id @default(uuid())
  minRoll   Int
  maxRoll   Int
  name      String
  effect    String
  updatedAt DateTime @updatedAt
}

/// Tabla de Eventos de Patada Inicial (2D6).
model MasterKickoffEntry {
  id        String   @id @default(uuid())
  roll      Int      @unique
  name      String
  effect    String
  updatedAt DateTime @updatedAt
}

/// Tabla de Plegarias a Nuffle (1D16).
model MasterPrayerEntry {
  id        String   @id @default(uuid())
  roll      Int      @unique
  name      String
  effect    String
  updatedAt DateTime @updatedAt
}

/// Tabla de Lesiones graves (1D16).
model MasterInjuryEntry {
  id                String   @id @default(uuid())
  minRoll           Int
  maxRoll           Int
  code              String
  name              String
  missesNextGame    Boolean  @default(false)
  permanentStatLoss Boolean  @default(false)
  isDeath           Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

/// Puntos de Estrellato (SPP/PE) por tipo de acción.
model MasterSppValue {
  id                  String   @id @default(uuid())
  actionKey           String   @unique
  label               String
  standardValue       Int
  /// Valor con la regla especial "Brutos Brutales" (null = sin cambio).
  brutosBrutalesValue Int?
  updatedAt           DateTime @updatedAt
}

/// Coste en PE de las mejoras de progresión (level up) y su impacto en el VAE.
model MasterLevelUpConfig {
  id            String   @id @default(uuid())
  configKey     String   @unique
  label         String
  sppCost       Int
  tvImpactMinGp Int?
  tvImpactMaxGp Int?
  updatedAt     DateTime @updatedAt
}

/// Incentivos comunes (contrataciones previas al partido). Coste en M.O.,
/// null = precio variable (depende del Incentivo elegido, ver `effect`).
model MasterInducement {
  id           String   @id @default(uuid())
  key          String   @unique
  name         String
  cost         Int?
  maxCount     Int
  /// Regla especial de equipo requerida (MasterSpecialRule.key en texto), o
  /// null si está disponible para cualquier equipo.
  restriction  String?
  effect       String
  sortOrder    Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/// Reglas especiales de equipo (Brutos Brutales, Elegidos de..., etc.) con
/// su texto completo — MasterRace.specialRules hoy solo guarda el nombre.
model MasterSpecialRule {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  updatedAt   DateTime @updatedAt
}

/// Los 4 estados de un jugador durante el partido (En pie, Distraído,
/// Tumbado boca arriba, Aturdido) — no son ni habilidades ni rasgos, así que
/// tienen su propia tabla de referencia. sortOrder fija el orden oficial en
/// vez de alfabético.
model MasterPlayerState {
  id          String   @id @default(uuid())
  key         String   @unique
  name        String
  description String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Tarjetas de la página /guia (qué es y para qué sirve cada apartado del
/// menú lateral) — contenido de la propia app, no reglas oficiales, pero
/// editable desde /admin igual que el resto para poder corregir el texto
/// sin desplegar código. emoji/href/color son estructurales (enlazan a una
/// ruta real) y no se editan desde el admin, solo title/description.
model MasterGuideSection {
  id          String   @id @default(uuid())
  key         String   @unique
  emoji       String
  title       String
  href        String
  color       String
  description String
  sortOrder   Int      @default(0)
  updatedAt   DateTime @updatedAt
}

/// Preguntas frecuentes de la página /guia.
model MasterGuideFaq {
  id        String   @id @default(uuid())
  key       String   @unique
  question  String
  answer    String
  sortOrder Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Razas / plantillas oficiales (Fase 1). Ver docs/RACES_DATA_MODEL.md.
// ─────────────────────────────────────────────────────────────────────────

model MasterRace {
  id               String   @id @default(uuid())
  key              String   @unique
  name             String
  pageRef          Int?
  tier             Int?
  /// Reglas especiales de equipo (ej. "Capitán del Equipo", "Brutos Brutales").
  specialRules     String[]
  /// Ligas a las que pertenece (determina qué estrellas puede fichar).
  leagues          String[]
  rerollCost       Int
  rerollMax        Int      @default(8)
  allowsApothecary Boolean  @default(true)
  sortOrder        Int      @default(0)
  positions        MasterPosition[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model MasterPosition {
  id                  String          @id @default(uuid())
  raceId              String
  race                MasterRace      @relation(fields: [raceId], references: [id], onDelete: Cascade)
  name                String
  /// Palabras clave del paréntesis: racial + posicional ("Grandullón"=Big Guy).
  playerTags          String[]
  quantityMin         Int             @default(0)
  quantityMax         Int
  cost                Int
  ma                  Int
  st                  Int
  /// AG/PA/AV como "para superar" (3 = 3+). pa null = no puede pasar ("–").
  ag                  Int
  pa                  Int?
  av                  Int
  /// Claves de habilidades/rasgos iniciales (catálogo estático).
  startingSkillKeys   String[]
  primaryCategories   SkillCategory[]
  secondaryCategories SkillCategory[]
  sortOrder           Int             @default(0)

  @@index([raceId])
}

model MasterStarPlayer {
  id              String   @id @default(uuid())
  key             String   @unique
  name            String
  playerTags      String[]
  cost            Int
  ma              Int
  st              Int
  ag              Int
  pa              Int?
  av              Int
  skillKeys       String[]
  /// "Cualquier equipo": puede ficharlo cualquier raza.
  playsForAny     Boolean  @default(false)
  /// Ligas para las que juega (si no es playsForAny).
  leagues         String[]
  specialRuleName String?
  specialRuleText String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ─────────────────────────────────────────────────────────────────────────
// Secuencia de Partido (chuleta editable). Ver src/rules-engine/data/
// matchSequence.ts para la semilla original y docs/MASTER_PLAN.md.
// ─────────────────────────────────────────────────────────────────────────

model MasterMatchSection {
  id        String   @id @default(uuid())
  /// "pre-partido" | "durante-el-partido" | "post-partido"
  key       String   @unique
  title     String
  intro     String
  /// Nota final de la sección (p.ej. el cambio de roles al descanso). Opcional.
  note      String?
  sortOrder Int      @default(0)
  steps     MasterMatchStep[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MasterMatchStep {
  id          String             @id @default(uuid())
  sectionId   String
  section     MasterMatchSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  sortOrder   Int
  title       String
  description String
  /// Notación de dados si aplica (p.ej. "2D6"). Opcional.
  dice        String?
  updatedAt   DateTime           @updatedAt

  @@index([sectionId])
}

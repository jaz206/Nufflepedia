# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local (ya está en .gitignore).

# Supabase (Configuracion -> API en el dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma (Supabase -> Configuracion -> Database -> Connection string -> "Transaction" pooler)
DATABASE_URL=
# Conexion directa (para migraciones), Supabase -> Database -> Connection string -> "Session")
DIRECT_URL=

# Gemini (generacion de nombres/escudos, opcional)
GEMINI_API_KEY=

# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local (ya está en .gitignore).

# Supabase (Settings -> API Keys en el dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NUNCA con prefijo NEXT_PUBLIC_: esta clave se usa solo en servidor.
SUPABASE_SECRET_KEY=

# Prisma: pon estas dos SOLO en tu .env (no en .env.local), la CLI de Prisma
# no lee .env.local y si duplicas la variable en los dos sitios se desincroniza.
# Transaction pooler (uso normal, puerto 6543) - anade ?pgbouncer=true al final:
DATABASE_URL=
# Session pooler (migraciones, puerto 5432) - evita el problema de IPv6 de la conexion directa:
DIRECT_URL=

# Gemini (usado por Balonazo Sangriento para generar cada numero de la revista;
# tambien reservado para una futura generacion de nombres/escudos)
GEMINI_API_KEY=

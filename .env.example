# Copia este archivo a .env.local y rellena los valores reales.
# Nunca commitees .env.local (ya está en .gitignore).

# Supabase (Settings -> API Keys en el dashboard del proyecto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NUNCA con prefijo NEXT_PUBLIC_: esta clave se usa solo en servidor.
SUPABASE_SECRET_KEY=

# Prisma (Supabase -> Configuracion -> Database -> Connection string -> "Transaction" pooler)
DATABASE_URL=
# Conexion directa (para migraciones), Supabase -> Database -> Connection string -> "Session")
DIRECT_URL=

# Gemini (generacion de nombres/escudos, opcional)
GEMINI_API_KEY=
